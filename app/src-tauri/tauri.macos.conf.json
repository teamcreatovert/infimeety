{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Infimeety",
        "width": 1320,
        "height": 840,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "shadow": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0a0a0f"
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "./macos/entitlements.plist"
    }
  }
}
