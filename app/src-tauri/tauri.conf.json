{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Infimeety",
  "version": "0.1.1",
  "identifier": "app.infimeety.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Infimeety",
        "width": 1320,
        "height": 840,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0a0a0f",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost blob: data: https: http://localhost:8787; media-src 'self' asset: http://asset.localhost blob: mediastream:; connect-src 'self' ipc: http://ipc.localhost https: wss: http://localhost:8787 ws://localhost:8787",
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Infimeety",
    "shortDescription": "Unlimited voice rooms, chat and watch-together",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "infimeety"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2QjM4OTcyREMyRDgyQjMKUldTemdpM2Njb216NXU5ZWdINW44Y2hHTGtOOG1JaHNsRjZPVFpjelJYZ2FyUlNOL2JGMmRVYXIK",
      "endpoints": [
        "https://github.com/teamcreatovert/infimeety/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
