{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infimeety-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },

  // PUBLIC_URL must be this Worker's public URL in production (used for OAuth redirects and avatar links).
  "vars": {
    "PUBLIC_URL": "https://infimeety-api.leveling-life-sync.workers.dev"
  },

  // `wrangler d1 create infimeety` prints the real database_id — paste it here before deploying.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "infimeety",
      "database_id": "30eda584-40b3-4f07-a69a-5498e3624770",
      "migrations_dir": "migrations"
    }
  ],

  // `wrangler kv namespace create AVATARS` prints the real id — paste it here before deploying.
  "kv_namespaces": [{ "binding": "AVATARS", "id": "8bdf1a31d8eb4d1886f62a90a1ef50fc" }],
  // Workers AI: speech to text for live captions (free daily allowance).
  "ai": { "binding": "AI" },

  "durable_objects": {
    "bindings": [
      { "name": "HUB", "class_name": "ChannelHub" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChannelHub"] },
    { "tag": "v2", "new_sqlite_classes": ["Lobby"] }
  ]
}
