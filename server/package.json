{
  "name": "infimeety-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply infimeety --local",
    "db:migrate:remote": "wrangler d1 migrations apply infimeety --remote",
    "typecheck": "tsc --noEmit",
    "pages:build": "npm --prefix ../app run build:web && node scripts/sound-pack.mjs",
    "pages:deploy": "npm run pages:build && cd pages && wrangler pages deploy --branch main --commit-dirty=true",
    "deploy:all": "npm run db:migrate:remote && wrangler deploy && npm run pages:deploy"
  },
  "dependencies": {
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "typescript": "~5.9",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
